# ---------------------------------------------------------------------------
# Slipstream — example environment file
#
# Copy to `.env` (repo root or `backend/.env`) and fill in what you need.
# Every setting has a working default for local development, so a blank file
# still boots. Only the production must-dos at the bottom are mandatory.
#
# This file carries NAMES ONLY. It intentionally contains no real keys,
# passwords, or hostnames — never commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
# Display name, public base URL, and the hostname the app is served from.
# ENVIRONMENT is one of: development | production | test
APP_NAME=
APP_URL=
DOMAIN=
ENVIRONMENT=
LOG_LEVEL=
LOG_JSON=

# --- Security --------------------------------------------------------------
# SECRET_KEY is REQUIRED in production; in development one is generated per
# boot, which invalidates sessions on restart. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# COOKIE_SECURE is derived from ENVIRONMENT when unset (true in production).
# TRUSTED_PROXY_COUNT is the number of reverse proxies in front of the app;
# leave at 0 unless a proxy you control sets X-Forwarded-For, otherwise
# clients can spoof their own IP and defeat rate limiting.
# CORS_ORIGINS is comma-separated; empty means same-origin only, which is the
# intended posture for this single-origin app.
SECRET_KEY=
SESSION_LIFETIME=
SESSION_COOKIE_NAME=
CSRF_COOKIE_NAME=
COOKIE_SECURE=
COOKIE_SAMESITE=
TRUSTED_PROXY_COUNT=
CORS_ORIGINS=

# --- Database --------------------------------------------------------------
# Defaults to SQLite under DATA_DIR (WAL mode).
DATABASE_URL=

# --- Initial admin ---------------------------------------------------------
# Seeded on first boot only. The seeded account is flagged as temporary: it
# can read the admin panel but cannot perform privileged mutations until the
# password is rotated. Set a strong password here before any real deployment.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Storage ---------------------------------------------------------------
# TEMP_DIR and LOG_DIR are derived from DATA_DIR when left empty.
DATA_DIR=
TEMP_DIR=
LOG_DIR=

# --- Limits ----------------------------------------------------------------
# Sizes in bytes, durations in seconds.
#   MAX_FILE_SIZE          default 2 GiB
#   MAX_VIDEO_DURATION     default 3 hours
#   MAX_CONCURRENT_DOWNLOADS  default 2 (raise only with the CPU to match:
#                             muxing is ffmpeg-bound)
#   TEMP_FILE_TTL          how long a finished file stays downloadable
#   CLEANUP_INTERVAL       gap between cleanup sweeps
#   HISTORY_RETENTION_DAYS how long download history rows are kept
MAX_FILE_SIZE=
MAX_VIDEO_DURATION=
MAX_CONCURRENT_DOWNLOADS=
JOB_TIMEOUT=
JOB_QUEUE_SIZE=
TEMP_FILE_TTL=
CLEANUP_INTERVAL=
HISTORY_RETENTION_DAYS=
ANALYZE_TIMEOUT=

# --- Rate limits (requests per hour) ---------------------------------------
# RATE_LIMIT_AUTH covers login and registration attempts per IP.
RATE_LIMIT_GUEST=
RATE_LIMIT_GUEST_DOWNLOAD=
RATE_LIMIT_USER=
RATE_LIMIT_USER_DOWNLOAD=
RATE_LIMIT_ADMIN=
RATE_LIMIT_AUTH=

# --- Feature flags ---------------------------------------------------------
# ALLOWED_PLATFORMS is comma-separated; empty means every registered provider.
REGISTRATION_ENABLED=
GUEST_DOWNLOADS_ENABLED=
MAINTENANCE_MODE=
ALLOWED_PLATFORMS=

# --- Extraction ------------------------------------------------------------
# FFMPEG_PATH/FFPROBE_PATH accept a bare command name or an absolute path.
# ALLOW_PRIVATE_NETWORK_TARGETS disables the SSRF guard that blocks private
# and loopback addresses. It exists for the test suite. Keep it false.
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PROXY=
YTDLP_USER_AGENT=
# Douyin fallback executes the public page in Chromium when yt-dlp receives
# the platform's JavaScript challenge. Set the executable explicitly on hosts
# where Chrome/Chromium is not in a standard location.
DOUYIN_BROWSER_FALLBACK=true
DOUYIN_BROWSER_EXECUTABLE=
DOUYIN_BROWSER_TIMEOUT=60
ALLOW_PRIVATE_NETWORK_TARGETS=

# --- Runtime toggles (env only, not part of Settings) ----------------------
# FRONTEND_DIST overrides where the built SPA is served from.
# SLIPSTREAM_SKIP_INIT skips database init during startup (used by tests).
FRONTEND_DIST=
SLIPSTREAM_SKIP_INIT=

# ---------------------------------------------------------------------------
# Production checklist
#   1. SECRET_KEY set to a long random value (see above)
#   2. ENVIRONMENT=production
#   3. INITIAL_ADMIN_PASSWORD set to something strong, then rotated in the UI
#   4. frontend/dist built (`npm --prefix frontend run build`)
#   5. ALLOW_PRIVATE_NETWORK_TARGETS left unset/false
# ---------------------------------------------------------------------------
