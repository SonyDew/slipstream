# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ruff format: double quotes, 100 columns (backend/pyproject.toml)
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,cjs,css,json,jsonc,html,svg}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab

# Windows-side scripts keep CRLF to match .gitattributes.
[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
