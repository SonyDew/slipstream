# ---------------------------------------------------------------------------
# Slipstream — repository ignores
#
# Anything that is generated, downloaded, machine-local, or user data belongs
# here. The runtime `data/` tree in particular holds the live SQLite database
# with the seeded admin account and downloaded media; it must never be
# committed.
# ---------------------------------------------------------------------------

# --- Runtime / user data ---------------------------------------------------
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Secrets & local configuration ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Node / frontend ------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Bundled local tooling (FFmpeg etc. fetched for local testing) --------
/.tools/

# --- Logs & temp ----------------------------------------------------------
*.log
logs/
tmp/
temp/

# --- Editors / OS ---------------------------------------------------------
.claude/
.playwright-cli/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Local agent handoff notes --------------------------------------------
/PROJECT_HANDOFF.md
/output/
/frontend/output/

# --- Stray local artefacts ------------------------------------------------
# One-off yt-dlp analyze dumps produced while poking at the extractor.
an.json
*.analyze.json
